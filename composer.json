{
    "name": "atelier/text",
    "description": "Map Unicode text to positioned font glyphs, vector outlines, and SVG documents using alto/font and atelier/svg.",
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/ateliersvg/text",
    "keywords": [
        "font",
        "glyph",
        "opentype",
        "svg",
        "text",
        "text-to-path",
        "truetype",
        "vector-graphics",
        "woff",
        "woff2"
    ],
    "support": {
        "issues": "https://github.com/ateliersvg/text/issues",
        "source": "https://github.com/ateliersvg/text"
    },
    "authors": [
        {
            "name": "Simon André",
            "email": "smn.andre@gmail.com"
        }
    ],
    "minimum-stability": "stable",
    "require": {
        "php": ">=8.4",
        "alto/font": "^0.8",
        "atelier/svg": "^1.0",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.94",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^13.1",
        "rector/rector": "^2.3"
    },
    "autoload": {
        "psr-4": {
            "Atelier\\Text\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Atelier\\Text\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "coverage": "vendor/bin/phpunit --coverage-text",
        "cs": "vendor/bin/php-cs-fixer fix --dry-run --diff --sequential",
        "cs:fix": "vendor/bin/php-cs-fixer fix --sequential",
        "qa": [
            "@cs",
            "@sa",
            "@test"
        ],
        "rector": "vendor/bin/rector process --dry-run",
        "sa": "vendor/bin/phpstan analyse --memory-limit=-1",
        "test": "vendor/bin/phpunit"
    }
}
